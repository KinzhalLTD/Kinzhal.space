rules_version = '2';
// Kinzhal Nest — Firestore security rules.
// Browsers may only read their own membership and the shared workspace documents (ws/*).
// Everything else (API keys, metrics, invites, team, audit, sync queue) is reachable only through the Netlify API,
// which uses the Admin SDK and checks roles itself.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && me().get('disabled', false) == false
        // "Sign out everywhere" and removed access: older sessions stop working at once
        && request.auth.token.auth_time > me().get('revokedAt', 0)
        // workspace rule "require 2-step verification"
        && (me().get('mfa', false) == false || request.auth.token.firebase.get('sign_in_second_factor', null) != null);
    }
    function canEdit() {
      return isMember() && me().role in ['owner', 'editor'];
    }
    // Any short workspace area name (games, tasks, mk, pm, …); new areas need no rules update.
    function sharedKey(k) {
      return k.matches('^[a-zA-Z]{1,20}$');
    }

    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /ws/{key} {
      allow read: if isMember();
      allow create, update: if canEdit()
        && sharedKey(key)
        && request.resource.data.keys().hasOnly(['json', 'by', 'at'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
